# ---------------------------------------------------------------------------
# Development target for the mobile app - what `npx expo start` uses.
#
# Expo loads env files by NODE_ENV. `npx expo start` runs in "development"
# and reads, highest priority first:
#
#     .env.development.local   (git-ignored)
#     .env.local               (git-ignored)   <- put a LOCAL backend here
#     .env.development         (this file, committed)
#     .env                     (git-ignored)
#
# `.env.production` is NOT read by `expo start`; it is read by `expo export`
# and EAS builds. That is why this file exists: without it a development
# build has no address and falls back to guessing "the machine running
# Metro, port 8000" - a laptop that is usually not running the backend.
#
# This file is committed on purpose. It is public configuration, not a
# secret: every EXPO_PUBLIC_ variable is inlined into the bundle and readable
# by anyone who unpacks the app, and the deployed API's address is not
# something a phone could be kept from knowing. NEVER put a credential, a
# token or a key in any file under mobile/.
#
# To develop against a LOCAL backend instead, do not edit this file: create
# mobile/.env.local (git-ignored) - see .env.example - and restart with
#     npx expo start --clear
# The home screen always shows which host the app is using.
# ---------------------------------------------------------------------------

# The deployed Django REST API on Railway, including the version prefix and a
# trailing slash. The same address frontend/.env.production points at.
EXPO_PUBLIC_API_BASE_URL=https://legalmetrology-compliance-production.up.railway.app/api/v1/
