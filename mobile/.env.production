# ---------------------------------------------------------------------------
# Production mobile configuration
#
# Expo loads this file automatically when NODE_ENV is "production" - that is,
# for `npx expo export` and for EAS builds with a production profile. It is
# NOT loaded by `npx expo start`: development reads `.env.development` (also
# committed, same address) and the git-ignored `.env.local`. Editing this
# file cannot change what a development build does.
#
# This file is committed on purpose - it is public configuration, not a secret,
# exactly as frontend/.env.production is. Every EXPO_PUBLIC_ variable ends up
# readable in the shipped bundle anyway, and the deployed API's address is not
# something an app could be kept from knowing. The secrets policy is unchanged:
# nothing confidential goes in any file under mobile/. See .env.example.
#
# A shell variable overrides this file, which is how a build for a different
# backend is made without editing it:
#     EXPO_PUBLIC_API_BASE_URL="https://other-host/api/v1/" npx expo export
# ---------------------------------------------------------------------------

# The deployed Django REST API on Railway, including the version prefix and a
# trailing slash. The same address frontend/.env.production points at.
EXPO_PUBLIC_API_BASE_URL=https://legalmetrology-compliance-production.up.railway.app/api/v1/
