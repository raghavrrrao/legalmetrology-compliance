{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["python /app/backend/manage.py deploy_setup"],
    "startCommand": "gunicorn --chdir /app/backend --config /app/backend/gunicorn.conf.py config.wsgi:application",
    "healthcheckPath": "/api/v1/health/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
