# ---------------------------------------------------------------------------
# Backend environment configuration
#
# Copy this file to `.env` in the REPOSITORY ROOT and fill in real values:
#     Windows PowerShell : Copy-Item .env.example .env
#     Windows cmd        : copy .env.example .env
#     macOS / Linux      : cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# Every variable below is read by backend/config/settings.py. If you add a
# variable there, document it here in the same commit.
#
# The frontend has its own separate file: frontend/.env.example. Never put a
# secret in that one - Vite variables are compiled into the browser bundle.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# REQUIRED. Generate a fresh key per environment; never reuse across machines:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# REQUIRED. Never enable DEBUG in a deployed environment - it exposes
# tracebacks, settings and SQL. Setting this to False also switches session and
# CSRF cookies to HTTPS-only automatically.
DJANGO_DEBUG=True

# Comma-separated hostnames Django will serve. Must be set when DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL. Optional, defaults to INFO.
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# REQUIRED (NAME, USER, PASSWORD). Create the database before migrating:
#   psql -U postgres -c "CREATE DATABASE legalmetrology;"
DATABASE_NAME=legalmetrology
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-me-with-your-local-postgres-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Seconds to keep a database connection open between requests.
# Optional, defaults to 60. Set to 0 if you run behind an external pooler.
DATABASE_CONN_MAX_AGE=60

# --- CORS ------------------------------------------------------------------
# Comma-separated list of EXACT browser origins allowed to call the API.
# This is the Vite dev server during local development. Wildcards are not
# supported by design - see docs/security.md.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Image upload ----------------------------------------------------------
# Maximum accepted product image size, in megabytes.
# Optional, defaults to 10. Enforced by apps.images.validators.
MAX_IMAGE_UPLOAD_SIZE_MB=10

# Upper bound on decoded pixel count (width x height), checked before any full
# decode. This is the decompression-bomb guard: a few-KB file can declare
# dimensions that expand to gigabytes in memory.
# Optional, defaults to 50000000 (50 megapixels).
MAX_IMAGE_PIXELS=50000000

# Directory for uploaded product images. Optional; defaults to backend/media/,
# which is git-ignored. In any shared environment point this at storage OUTSIDE
# the repository - uploaded label images are third-party content.
DJANGO_MEDIA_ROOT=

# --- HTTPS (deployment only) -----------------------------------------------
# Both are read ONLY when DJANGO_DEBUG=False, so they have no effect locally.
# Redirect plain HTTP to HTTPS. Optional, defaults to True.
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds. Optional, defaults to 31536000 (one year).
# Set to 0 while first testing a deployment - browsers cache this aggressively
# and a wrong value is hard to undo.
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- API throttling --------------------------------------------------------
# Django REST Framework throttle rates, format "<count>/<period>".
# Optional; the defaults below apply when unset.
API_THROTTLE_ANON=30/min
API_THROTTLE_USER=120/min

# --- Extraction (OCR / ML) -------------------------------------------------
# Which extraction pipeline apps.extraction requests from the labelextract
# registry. Optional.
#
# Two pipelines are registered:
#
#   null-engine  0.1.0   Placeholder. Reads no pixels, returns no text, and
#                        flags every result is_placeholder=true so the UI can
#                        never present wiring output as a genuine reading.
#
#   tesseract    0.2.0   Real OCR: Pillow preprocessing (including a 2x
#                        upscale of small photographs) -> Tesseract 5 at
#                        --psm 3 -> deterministic English field extraction.
#
#   tesseract    0.1.0   The frozen previous configuration, kept registered so
#                        runs recorded under it stay reproducible and so 0.2.0
#                        can be measured against something. Do not select it
#                        for new work.
#
# The placeholder is the default on purpose. Tesseract needs a system binary
# that is not installed by pip, and a default that failed on a teammate's first
# upload would be worse than one that is honestly inert. Switch over only once
# `tesseract --version` works on your machine:
#
#     pip install -e "./ml[ocr]"
#     # plus the binary - see ml/README.md for your platform
#     DEFAULT_EXTRACTION_ENGINE_NAME=tesseract
#     DEFAULT_EXTRACTION_ENGINE_VERSION=0.2.0
#
# The version is the *pipeline's*, not the Tesseract binary's. The binary
# version is recorded per run in ExtractionRun.raw_output.
#
# There is no API key, endpoint or credential for OCR, and there never should
# be: recognition runs entirely on this machine and no uploaded label leaves it.
DEFAULT_EXTRACTION_ENGINE_NAME=null-engine
DEFAULT_EXTRACTION_ENGINE_VERSION=0.1.0

# --- Compliance rules ------------------------------------------------------
# Directory the `load_rules` management command reads rule definitions from.
# Optional; defaults to <repo root>/rules/definitions.
RULES_DEFINITIONS_DIR=

# ---------------------------------------------------------------------------
# Demonstration mode
# ---------------------------------------------------------------------------

# Opens POST /api/v1/images/ and GET /api/v1/compliance/<id>/ to anonymous
# callers. Nothing else is affected, and uploads still go through
# apps.images.validators in full.
#
# Leave this False (the default) unless you are running a local demonstration.
# The API denies by default and there is no login screen yet, so a demo needs
# these two endpoints reachable without one - but that relaxation must never
# reach a deployment, which is why the default is closed and this file ships
# it closed.
DEMO_PUBLIC_ANALYSIS_API=False
