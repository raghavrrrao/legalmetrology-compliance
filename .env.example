# ---------------------------------------------------------------------------
# Backend environment configuration
#
# Copy this file to `.env` in the REPOSITORY ROOT and fill in real values:
#     Windows PowerShell : Copy-Item .env.example .env
#     Windows cmd        : copy .env.example .env
#     macOS / Linux      : cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# Every variable below is read by backend/config/settings.py, except the
# gunicorn block near the end, which is read by backend/gunicorn.conf.py. If you
# add a variable to either file, document it here in the same commit.
#
# For a deployment, these are set as platform environment variables rather than
# in a file - see docs/deployment.md for which ones Railway needs and which two
# hostnames it supplies for you.
#
# The frontend has its own separate file: frontend/.env.example. Never put a
# secret in that one - Vite variables are compiled into the browser bundle.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# REQUIRED. Generate a fresh key per environment; never reuse across machines:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# REQUIRED. Never enable DEBUG in a deployed environment - it exposes
# tracebacks, settings and SQL. Setting this to False also switches session and
# CSRF cookies to HTTPS-only automatically.
DJANGO_DEBUG=True

# Comma-separated hostnames Django will serve. Must be set when DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL. Optional, defaults to INFO.
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# Two ways in. DATABASE_URL WINS whenever it is set; the discrete variables
# below are then ignored entirely, including DATABASE_NAME. That ordering is
# deliberate - a platform that hands you a URL hands you a complete one, and a
# half-overridden connection is the failure it prevents.
#
# A managed platform (Railway, Heroku, Fly) provides DATABASE_URL. Reference it
# from the database service rather than pasting a literal, so it follows the
# database if it is ever recreated:
#
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Leave it EMPTY for local development and use the discrete variables instead.
DATABASE_URL=

# REQUIRED for local development (NAME, USER, PASSWORD), and unused when
# DATABASE_URL is set. Create the database before migrating:
#   psql -U postgres -c "CREATE DATABASE legalmetrology;"
DATABASE_NAME=legalmetrology
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-me-with-your-local-postgres-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Seconds to keep a database connection open between requests. Applied to
# whichever of the two branches above produced the connection.
# Optional, defaults to 60. Set to 0 if you run behind an external pooler.
DATABASE_CONN_MAX_AGE=60

# Check a reused connection before handing it to a view. Optional, defaults to
# True. Leave it on behind a managed platform's proxy, which drops idle
# connections - without it that surfaces as an InterfaceError on a request that
# did nothing wrong. Irrelevant when DATABASE_CONN_MAX_AGE is 0.
DATABASE_CONN_HEALTH_CHECKS=True

# --- CORS ------------------------------------------------------------------
# Comma-separated list of EXACT browser origins allowed to call the API.
# This is the Vite dev server during local development, and the deployed
# frontend's origin in a deployment. Wildcards are not supported by design -
# see docs/security.md.
#
# CSRF_TRUSTED_ORIGINS is DERIVED from this list and is not a separate variable.
# CORS and CSRF are different controls (docs/deployment.md explains which
# failure is which), but they need the same origins here, so they are set once.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Image upload ----------------------------------------------------------
# Maximum accepted product image size, in megabytes.
# Optional, defaults to 10. Enforced by apps.images.validators.
MAX_IMAGE_UPLOAD_SIZE_MB=10

# Upper bound on decoded pixel count (width x height), checked before any full
# decode. This is the decompression-bomb guard: a few-KB file can declare
# dimensions that expand to gigabytes in memory.
# Optional, defaults to 50000000 (50 megapixels).
MAX_IMAGE_PIXELS=50000000

# Directory for uploaded product images. Optional; defaults to backend/media/,
# which is git-ignored. In any shared environment point this at storage OUTSIDE
# the repository - uploaded label images are third-party content.
#
# ON A MANAGED PLATFORM THIS DIRECTORY IS EPHEMERAL unless a volume is mounted
# over it. Every deploy and restart replaces the container filesystem, so the
# database keeps the rows and loses the photographs they point at. Mount a
# volume and point this at it to keep them. Object storage (S3 and friends) is
# NOT a drop-in alternative today - extraction opens a local path - see the
# media section of docs/deployment.md.
DJANGO_MEDIA_ROOT=

# --- HTTPS (deployment only) -----------------------------------------------
# Both are read ONLY when DJANGO_DEBUG=False, so they have no effect locally.
# Redirect plain HTTP to HTTPS. Optional, defaults to True.
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds. Optional, defaults to 31536000 (one year).
# Set to 0 while first testing a deployment - browsers cache this aggressively
# and a wrong value is hard to undo.
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- API throttling --------------------------------------------------------
# Django REST Framework throttle rates, format "<count>/<period>".
# Optional; the defaults below apply when unset.
API_THROTTLE_ANON=30/min
API_THROTTLE_USER=120/min

# --- Extraction (OCR / ML) -------------------------------------------------
# Which extraction pipeline apps.extraction requests from the labelextract
# registry. Optional.
#
# Four name/version pairs are registered (ml/labelextract/registry.py):
#
#   null-engine  0.1.0   Placeholder. Reads no pixels, returns no text, and
#                        flags every result is_placeholder=true so the UI can
#                        never present wiring output as a genuine reading.
#
#   tesseract    0.3.0   Real OCR, and the one to use: Pillow preprocessing
#                        (including a 2x upscale of small photographs) ->
#                        Tesseract 5 at --psm 3, retrying with a second
#                        segmentation mode when a pass recognises nothing ->
#                        deterministic English field extraction.
#
#   tesseract    0.2.0   0.3.0 without the empty-result retry.
#   tesseract    0.1.0   The original configuration.
#
#                        Both are frozen and kept registered so a run recorded
#                        under one stays reproducible, and so each change can be
#                        re-measured rather than taken on trust. Do not select
#                        either for new work.
#
# The placeholder is the default on purpose. Tesseract needs a system binary
# that is not installed by pip, and a default that failed on a teammate's first
# upload would be worse than one that is honestly inert. Switch over only once
# `tesseract --version` works on your machine:
#
#     pip install -e "./ml[ocr]"
#     # plus the binary - see ml/README.md for your platform
#     DEFAULT_EXTRACTION_ENGINE_NAME=tesseract
#     DEFAULT_EXTRACTION_ENGINE_VERSION=0.3.0
#
# The version is the *pipeline's*, not the Tesseract binary's. The binary
# version is recorded per run in ExtractionRun.raw_output.
#
# A DEPLOYMENT MUST SET THESE TWO. Left at the defaults, a deployed container
# runs the placeholder and reads nothing off any label. The Dockerfile installs
# the binary, so `available` on /api/v1/health/ confirms it answered - and a
# deployment is genuinely doing OCR only when that endpoint reports
# is_placeholder=false AND available=true.
#
# There is no API key, endpoint or credential for OCR, and there never should
# be: recognition runs entirely on this machine and no uploaded label leaves it.
DEFAULT_EXTRACTION_ENGINE_NAME=null-engine
DEFAULT_EXTRACTION_ENGINE_VERSION=0.1.0

# --- Compliance rules ------------------------------------------------------
# Directory the `load_rules` management command reads rule definitions from:
# the checks this software can actually execute.
# Optional; defaults to <repo root>/rules/definitions.
RULES_DEFINITIONS_DIR=

# Directory the `load_legal_framework` management command reads from: the
# instruments, applicability conditions and clause-level requirements of the
# Rules themselves. Separate from the directory above because the two hold
# different things - what the law requires, and what this software can evaluate.
# Optional; defaults to <repo root>/rules/framework.
RULES_FRAMEWORK_DIR=

# ---------------------------------------------------------------------------
# Demonstration mode
# ---------------------------------------------------------------------------

# Opens POST /api/v1/images/ and GET /api/v1/compliance/<id>/ to anonymous
# callers. Nothing else is affected, and uploads still go through
# apps.images.validators in full.
#
# Leave this False (the default) unless you are running a local demonstration.
# The API denies by default and there is no login screen yet, so a demo needs
# these two endpoints reachable without one - but that relaxation must never
# reach a deployment by accident, which is why the default is closed and this
# file ships it closed.
#
# If a public SIH demonstration deployment turns it on deliberately, this is
# exactly what becomes true, and it should be said out loud rather than
# discovered:
#
#   * anyone with the URL can upload a photograph and consume OCR and database
#     capacity, bounded only by API_THROTTLE_ANON above;
#   * anonymous results are a SHARED POOL - every anonymous caller can read
#     every anonymously created result. Authenticated users' results stay
#     private to them regardless of this flag
#     (CallerScopedCheckQuerysetMixin enforces that, not this switch);
#   * nothing about upload validation is relaxed.
#
# If real submissions will be stored, leave it False and add authentication
# first. See docs/deployment.md and docs/security.md.
DEMO_PUBLIC_ANALYSIS_API=False


# ---------------------------------------------------------------------------
# Gunicorn (deployment only)
# ---------------------------------------------------------------------------
#
# Read by backend/gunicorn.conf.py, not by Django. They have no effect on
# `manage.py runserver`, and gunicorn is POSIX-only - it does not run on
# Windows, so these matter in the container and nowhere else.

# TCP port to bind. Supplied by the platform in a deployment; the config file
# falls back to 8000 when it is absent. Do not set this on Railway - it injects
# PORT itself, and defining your own stops it routing to the right one.
# PORT=8000

# Number of worker PROCESSES. Optional, defaults to 1 - and that default is a
# correctness decision, not a resource one.
#
# DRF's throttle counters live in Django's cache, which is LocMemCache, which is
# per-process. Two workers means two independent counters and roughly double the
# configured rate limit. Before raising this on anything public, either accept
# per-worker throttling or point CACHES at a shared backend (Redis, Memcached)
# first. Concurrency within one worker comes from GUNICORN_THREADS below, which
# shares the process and therefore the counter.
# WEB_CONCURRENCY=1

# Threads per worker. Optional, defaults to 4. Extraction is a subprocess call
# to the Tesseract binary that spends nearly all its time waiting, so threads
# absorb concurrent uploads cheaply.
# GUNICORN_THREADS=4

# Seconds before a worker is considered stuck and killed. Optional, defaults to
# 120. Gunicorn's own default of 30 is too tight for a large photograph on a
# small container, and a worker killed mid-extraction leaves the image row in
# PROCESSING with nothing recording why.
# GUNICORN_TIMEOUT=120

# Gunicorn's log level. Optional, defaults to info. Separate from
# DJANGO_LOG_LEVEL above, which controls the application's own loggers.
# GUNICORN_LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Supplied by the platform - do not set these yourself
# ---------------------------------------------------------------------------
#
# Listed because config/settings.py READS them, so anyone auditing the settings
# against this file would otherwise find two variables documented nowhere.
#
#   RAILWAY_ENVIRONMENT_NAME   Set by Railway. Its mere presence is what allows
#                              the two hostnames below into ALLOWED_HOSTS, so
#                              nothing is widened on a laptop or in CI.
#   RAILWAY_PUBLIC_DOMAIN      The generated *.up.railway.app domain, appended
#                              to ALLOWED_HOSTS along with the platform's own
#                              health-probe host, healthcheck.railway.app.
#
# A custom domain is NOT supplied by the platform and still belongs in
# DJANGO_ALLOWED_HOSTS. See docs/deployment.md.
