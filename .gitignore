# ---------------------------------------------------------------------------
# Secrets and local environment configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Python build output. Scoped with a leading slash so that a source directory
# named "build" inside an app would not be ignored by accident.
/build/
/dist/
/ml/build/
/ml/dist/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.log
db.sqlite3
db.sqlite3-journal
/backend/media/
/backend/staticfiles/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
/frontend/dist/
/frontend/build/
/frontend/coverage/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# This project standardises on npm. Do not commit competing lockfiles -
# package-lock.json IS committed and must not be ignored.
pnpm-lock.yaml
yarn.lock

# ---------------------------------------------------------------------------
# ML / OCR artifacts
# ---------------------------------------------------------------------------
# Model weights and training data must never enter Git history: once committed
# they are in every clone forever. See ml/README.md for the storage strategy.
/ml/artifacts/
/ml/models/

# Everything *inside* ml/data/ is ignored - photographs, datasets, annotations.
# The empty directory scaffolding and its README are not, so a fresh clone
# already knows where images go instead of inventing a layout. The three
# negations re-include directories (so Git descends into them at all), the
# README, and the .gitkeep placeholders - and nothing else. Any image dropped
# into these folders still matches the first line and stays out of Git.
# See ml/data/README.md.
/ml/data/**
!/ml/data/**/
!/ml/data/README.md
!/ml/data/**/.gitkeep
*.pt
*.pth
*.onnx
*.h5
*.ckpt
*.pkl
*.joblib
*.tflite
*.traineddata

# ---------------------------------------------------------------------------
# Local sample and uploaded product images
# ---------------------------------------------------------------------------
# Uploaded label images can contain third-party trade dress and personal data.
# Keep them out of the repository. Small committed test fixtures are allowed.
/samples/
/uploads/
