# ---------------------------------------------------------------------------
# Frontend environment configuration
#
# Copy this file to `.env` inside frontend/:
#     Windows PowerShell : Copy-Item .env.example .env
#     macOS / Linux      : cp .env.example .env
#
# SECURITY - read before adding anything here.
#
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle at
# build time. Anything in this file is readable by anyone who opens the site
# and views the source. It is public configuration, not configuration that
# merely happens to be stored on the client.
#
# NEVER put a secret here: no API keys, no database credentials, no tokens,
# no Django SECRET_KEY. Secrets belong in the root .env, which only the
# backend reads and which is never bundled.
#
# Variables without the VITE_ prefix are not exposed to the browser, but do
# not rely on that as a security boundary - keep secrets out of this directory
# entirely.
# ---------------------------------------------------------------------------

# Base URL of the Django REST API, including the version prefix and a trailing
# slash. This is the ONLY place the backend URL is configured; no component
# hardcodes it.
#
# The /api/v1/ suffix is part of the value. Services ask for paths relative to
# it ('health/', 'compliance/'), so an origin on its own would send every
# request to the wrong place.
VITE_API_BASE_URL=http://localhost:8000/api/v1/

# 127.0.0.1 instead of localhost is equally correct, and is the value to use if
# your machine resolves localhost to IPv6 and Django is listening on IPv4 only:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/

# ---------------------------------------------------------------------------
# Production
#
# `npm run dev` reads this file (via your .env copy). `npm run build` does not
# need it: Vite loads `frontend/.env.production`, which is committed and points
# at the deployed Railway API:
#
#     VITE_API_BASE_URL=https://legalmetrology-compliance-production.up.railway.app/api/v1/
#
# The value is baked into the bundle at build time, so changing it means
# rebuilding - there is no runtime setting to flip on the host. A shell
# variable overrides both files:
#
#     VITE_API_BASE_URL="https://other-host/api/v1/" npm run build
#
# Whatever origin the built frontend is served from must be listed in the
# backend's CORS_ALLOWED_ORIGINS, or the browser blocks every response. See
# docs/deployment.md.
# ---------------------------------------------------------------------------
