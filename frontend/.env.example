# ---------------------------------------------------------------------------
# Frontend environment configuration
#
# Copy this file to `.env` inside frontend/:
#     Windows PowerShell : Copy-Item .env.example .env
#     macOS / Linux      : cp .env.example .env
#
# SECURITY - read before adding anything here.
#
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle at
# build time. Anything in this file is readable by anyone who opens the site
# and views the source. It is public configuration, not configuration that
# merely happens to be stored on the client.
#
# NEVER put a secret here: no API keys, no database credentials, no tokens,
# no Django SECRET_KEY. Secrets belong in the root .env, which only the
# backend reads and which is never bundled.
#
# Variables without the VITE_ prefix are not exposed to the browser, but do
# not rely on that as a security boundary - keep secrets out of this directory
# entirely.
# ---------------------------------------------------------------------------

# Base URL of the Django REST API, including the version prefix and a trailing
# slash. This is the ONLY place the backend URL is configured; no component
# hardcodes it.
VITE_API_BASE_URL=http://localhost:8000/api/v1/
